# Product branding: the ONE place to change the name. Sourced by fork/scripts/*.sh and the CI workflows.
# Changing them needs a fresh prepare (fork/scripts/prepare-vscodium.sh). Icons: branding/README.md.
APP_NAME="editor"                    # display name (nameShort / nameLong, window title, menus, editor.app, Windows display names)
BINARY_NAME="editor"                 # executable + applicationName (VSCode-linux-x64/editor, editor.app)
DATA_FOLDER_NAME=".editor"           # ~/.editor (extensions, argv.json)
USER_DATA_FOLDER_NAME="Editor"       # ~/.config/Editor, ~/Library/Application Support/Editor. Capitalized: existing installs keep their data
URL_PROTOCOL="editor"                # editor://… deep links
DARWIN_BUNDLE_ID="dev.editor.Editor" # macOS bundle identifier (an identifier, not shown; changing it orphans macOS permissions and defaults)
ORG_NAME="guruvamsi-policharla"      # used by VSCodium patch placeholders (!!ORG_NAME!!)
GH_REPO_PATH="guruvamsi-policharla/editor"  # releases / issue links (!!GH_REPO_PATH!!)
