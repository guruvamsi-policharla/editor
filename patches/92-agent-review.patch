+	border-left: 4px solid var(--vscode-diffEditor-insertedTextBorder);
+	background-color: color-mix(in srgb, var(--vscode-diffEditor-insertedTextBorder) 16%, transparent);
+}
+
+/* Inserted words: a stronger tint of the same color, instead of a dashed box around each one (and each whole new line). */
+.monaco-editor.hc-black .char-insert.agent-review-inserted-text,
+.monaco-editor.hc-light .char-insert.agent-review-inserted-text {
+	border: none;
+	background-color: color-mix(in srgb, var(--vscode-diffEditor-insertedTextBorder) 35%, transparent);
+}
+
+/* Deleted words in a red row: struck (below) and tinted like inserted words, not a dashed box (#45). */
+.monaco-editor.hc-black .chat-editing-original-zone.agent-review-deleted-lines .view-line .char-delete,
+.monaco-editor.hc-light .chat-editing-original-zone.agent-review-deleted-lines .view-line .char-delete {
+	border: none;
+	background-color: color-mix(in srgb, var(--vscode-diffEditor-removedTextBorder) 35%, transparent);
+}
+
+.monaco-editor.hc-black .chat-editing-original-zone.agent-review-deleted-lines,
+.monaco-editor.hc-light .chat-editing-original-zone.agent-review-deleted-lines {
+	border: none;
+	border-left: 4px solid var(--vscode-diffEditor-removedTextBorder);
+	background-color: color-mix(in srgb, var(--vscode-diffEditor-removedTextBorder) 16%, transparent);
+}
+
+.monaco-editor.hc-black .inline-deleted-text.agent-review-deleted-text,
+.monaco-editor.hc-light .inline-deleted-text.agent-review-deleted-text,
+.monaco-editor.hc-black .chat-editing-original-zone.agent-review-deleted-lines .view-line .char-delete,
+.monaco-editor.hc-light .chat-editing-original-zone.agent-review-deleted-lines .view-line .char-delete,
+.monaco-editor.hc-black .chat-editing-original-zone.agent-review-deleted-whole-lines .view-line span,
+.monaco-editor.hc-light .chat-editing-original-zone.agent-review-deleted-whole-lines .view-line span {
+	text-decoration-color: var(--vscode-diffEditor-removedTextBorder);
+	text-decoration-thickness: 2px;
+}
+
+.hc-black .chat-diff-change-content-widget.agent-review-hunk-toolbar,
+.hc-light .chat-diff-change-content-widget.agent-review-hunk-toolbar {
+	opacity: 1;
+}
+
+.hc-black .chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar .action-item .action-label:not(.codicon),
+.hc-light .chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar .action-item .action-label:not(.codicon) {
+	padding: 0 7px;
+	border: 1px solid var(--vscode-button-border, var(--vscode-contrastBorder));
+}
+
+.hc-black .chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar .action-item.primary .action-label:not(.codicon),
+.hc-light .chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar .action-item.primary .action-label:not(.codicon) {
+	font-weight: 600;
+}
+
+.monaco-workbench.hc-black .chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar .action-item .action-label:hover,
+.monaco-workbench.hc-light .chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar .action-item .action-label:hover {
+	outline: 1px dashed var(--vscode-contrastActiveBorder);
+	outline-offset: -1px;
+}
