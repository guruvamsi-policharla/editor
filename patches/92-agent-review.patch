--- /dev/null
+++ b/src/vs/workbench/contrib/agentReview/browser/media/agentReview.css
@@ -0,0 +1,213 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Agent review: each hunk's Keep/Undo toolbar is always visible and never covers text: at the right end of
+ * the hunk's last row when there is room (`at-line-end`), else in its own row below the hunk (`in-own-row`),
+ * aligned with the start of the text (see ChatEditingCodeEditorIntegration). Nothing is under it, so it's
+ * drawn as plain buttons rather than a floating box. It's slightly dimmed until the pointer or the cursor
+ * is in the change. (The chat UI floats it over the hunk's first line on hover.)
+ */
+.chat-diff-change-content-widget.agent-review-hunk-toolbar {
+	opacity: 0.85;
+	box-shadow: none;
+	border-radius: 4px;
+	overflow: visible;
+}
+
+.chat-diff-change-content-widget.agent-review-hunk-toolbar.under-editor-overlay {
+	visibility: hidden;
+}
+
+.chat-diff-change-content-widget.agent-review-hunk-toolbar.hover,
+.chat-diff-change-content-widget.agent-review-hunk-toolbar:hover {
+	opacity: 1;
+}
+
+.chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar {
+	padding: 0;
+	border: none;
+	background-color: transparent;
+}
+
+.chat-diff-change-content-widget.agent-review-hunk-toolbar .monaco-action-bar .actions-container {
