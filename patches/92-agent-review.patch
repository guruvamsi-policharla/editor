+	background-color: var(--vscode-toolbar-hoverBackground);
+}
+
+/*
+ * Deleted text is struck through wherever it shows:
+ *  - track changes: deleted words in the line, right before the new ones. The struck text and the strike are tinted
+ *    red, so that a short word (a renamed `x`) still reads as a deleted letter, not as `*`.
+ *  - red rows: every row of a deleted block (`agent-review-deleted-whole-lines`), and the deleted words of rewritten
+ *    lines (`char-delete`, whole lines included). The rows keep their syntax colors, and the strike is drawn in the
+ *    text's own color, which reads on the red rows in every theme.
+ * The selectors outrank token styles (`.mtku` underline, `.mtks`), so no token turns the strike off.
+ */
+.monaco-editor .inline-deleted-text.agent-review-deleted-text {
+	text-decoration-line: line-through;
+	text-decoration-thickness: 1px;
+	text-decoration-color: var(--vscode-editorGutter-deletedBackground);
