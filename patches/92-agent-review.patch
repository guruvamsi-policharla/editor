+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Agent review: each hunk's Keep/Undo toolbar is always visible, in its own row below the hunk
+ * (`in-own-row`, see ChatEditingCodeEditorIntegration), aligned with the start of the text. Nothing is
+ * under it, so it's drawn as plain buttons rather than a floating box. It's slightly dimmed until the
+ * pointer or the cursor is in the change. (The chat UI floats it over the hunk's first line on hover.)
+ */
+.chat-diff-change-content-widget.in-own-row {
+	opacity: 0.85;
+	box-shadow: none;
+	border-radius: 4px;
+	overflow: visible;
+}
+
+.chat-diff-change-content-widget.in-own-row.hover,
+.chat-diff-change-content-widget.in-own-row:hover {
+	opacity: 1;
+}
+
+.chat-diff-change-content-widget.in-own-row .monaco-action-bar {
+	padding: 0;
+	border: none;
+	background-color: transparent;
+}
+
+.chat-diff-change-content-widget.in-own-row .monaco-action-bar .actions-container {
+	gap: 6px;
+}
+
+.chat-diff-change-content-widget.in-own-row .monaco-action-bar .action-item .action-label {
+	padding: 1px 8px;
+	font-size: 11px;
+	line-height: 16px;
+	border-radius: 4px;
+	background-color: var(--vscode-button-secondaryBackground);
+	color: var(--vscode-button-secondaryForeground);
+}
+
+.monaco-workbench .chat-diff-change-content-widget.in-own-row .monaco-action-bar .action-item .action-label:hover {
+	background-color: var(--vscode-button-secondaryHoverBackground);
+}
+
+.chat-diff-change-content-widget.in-own-row .monaco-action-bar .action-item.primary .action-label {
+	background-color: var(--vscode-button-background);
