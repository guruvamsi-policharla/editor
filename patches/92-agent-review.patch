+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Agent review: one entry per file with pending agent changes. The "original" side is the review
+// engine's accepted baseline (pushed in from the built-in agent-review extension, which owns the
+// engine) and the "modified" side is the live text model of the file. Rendering, per-hunk Keep/Undo
+// widgets, navigation and the editor overlay are the chat-editing UI (ChatEditingCodeEditorIntegration).
+//
+// Who decides what: the engine is authoritative (pending = disk - baseline). This entry only
+// reports what the user did in the UI so the engine can follow:
+//   Keep hunk  -> original model edited here -> 'accepted' with the full new baseline
+//   Undo hunk  -> buffer edited here -> saved (when it was clean) -> the engine sees disk == baseline there
+//   Keep file  -> 'acceptFile';  Undo file -> buffer restored + saved, or 'rejectFile' for a created file
+// Ctrl+Z after a Keep puts the change back up for review ('restore' with the previous baseline, see
+// AgentReviewService); Ctrl+Z after an Undo brings the agent's text back as a pending change (and saves it, as
+// the Undo was saved), never as if the user had typed it.
+// Undo writes the file, so the disk matches what the reviewer sees and the agent can't read the undone text
+// back. The one exception is a buffer with the user's own unsaved edits: it's never saved for them, so the
+// undo stays in the buffer (dirty) until they save. Keep never writes: the agent's text is already on disk.
+
+import { toAction } from '../../../../base/common/actions.js';
+import { Emitter } from '../../../../base/common/event.js';
+import { Disposable, DisposableMap, IReference } from '../../../../base/common/lifecycle.js';
+import { ResourceMap } from '../../../../base/common/map.js';
+import { constObservable, derived, IObservable, observableValue } from '../../../../base/common/observable.js';
+import { basename } from '../../../../base/common/resources.js';
+import { URI } from '../../../../base/common/uri.js';
+import { getCodeEditor, ICodeEditor } from '../../../../editor/browser/editorBrowser.js';
+import { IDocumentDiff } from '../../../../editor/common/diff/documentDiffProvider.js';
+import { DetailedLineRangeMapping } from '../../../../editor/common/diff/rangeMapping.js';
+import { ILanguageService } from '../../../../editor/common/languages/language.js';
+import { EndOfLinePreference, ITextModel } from '../../../../editor/common/model.js';
+import { createTextBufferFactory } from '../../../../editor/common/model/textModel.js';
+import { IModelService } from '../../../../editor/common/services/model.js';
+import { IResolvedTextEditorModel } from '../../../../editor/common/services/resolverService.js';
+import { IModelContentChangedEvent } from '../../../../editor/common/textModelEvents.js';
+import { localize } from '../../../../nls.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { INotificationService, Severity } from '../../../../platform/notification/common/notification.js';
+import { IEditorPane, SaveReason } from '../../../common/editor.js';
+import { ITextFileService } from '../../../services/textfile/common/textfiles.js';
+import { ChatEditingCodeEditorIntegration, IDocumentDiff2 } from '../../chat/browser/chatEditing/chatEditingCodeEditorIntegration.js';
+import { ChatEditingTextModelChangeService } from '../../chat/browser/chatEditing/chatEditingTextModelChangeService.js';
+import { IModifiedFileEntry, IModifiedFileEntryEditorIntegration, ModifiedFileEntryState } from '../../chat/common/editing/chatEditingService.js';
+import { IChatResponseModel } from '../../chat/common/model/chatModel.js';
+
+export const AGENT_REVIEW_BASELINE_SCHEME = 'agent-review-baseline';
+
+/** How the file differs from the baseline: `created` files have an empty baseline and no file there before. */
+export type AgentReviewKind = 'modified' | 'created';
+
+export interface IAgentReviewHunkEvent {
+	readonly uri: URI;
+	/**
+	 * - `accepted`: one hunk kept; `baseline` is the full new baseline text.
+	 * - `rejected`: one hunk undone in the buffer (the engine follows from the save).
+	 * - `acceptFile`: everything in the file kept (accept the file as it is on disk).
+	 * - `rejectFile`: undo a created file, i.e. delete it.
+	 * - `restore`: set the baseline back to `baseline` (`null`: a pending creation); Ctrl+Z after a Keep.
+	 */
+	readonly kind: 'accepted' | 'rejected' | 'acceptFile' | 'rejectFile' | 'restore';
+	readonly baseline?: string | null;
+	/** For `accepted` and `acceptFile`: the baseline before the Keep (`null`: the file was a pending creation). */
+	readonly previousBaseline?: string | null;
+}
+
+/** Content changes caused by reloading the file from disk are agent (external) edits. */
+export function isDiskReload(e: IModelContentChangedEvent): boolean {
+	return e.detailedReasons.some(r => r.metadata.source === 'reloadFromDisk');
+}
+
+/**
+ * Per file: the buffer text right before and after each Undo (newest last, bounded). An editor undo (Ctrl+Z) that
+ * brings the buffer back to `before` takes that Undo back, so the agent's text is pending again rather than the
+ * user's typing; a redo back to `after` repeats it. `saved`: the Undo was saved, so taking it back is saved too.
+ * Owned by the service, because the last Undo in a file removes the file's entry.
+ */
+export class AgentReviewUndoHistory {
+	private readonly _snapshots = new ResourceMap<{ readonly before: string; readonly after: string; readonly saved: boolean }[]>();
+	private readonly _onDidRemember = new Emitter<ITextModel>();
+	readonly onDidRemember = this._onDidRemember.event;
+
+	remember(model: ITextModel, before: string, saved: boolean): void {
+		let list = this._snapshots.get(model.uri);
+		if (!list) {
+			list = [];
+			this._snapshots.set(model.uri, list);
+		}
+		list.push({ before, after: model.getValue(), saved });
+		if (list.length > 20) {
+			list.shift();
+		}
+		this._onDidRemember.fire(model);
+	}
+
+	/** The Undo that this editor undo/redo of `model` takes back or repeats, if any. Call while handling the change. */
+	match(model: ITextModel, e: IModelContentChangedEvent): { readonly saved: boolean } | undefined {
+		const list = this._snapshots.get(model.uri);
+		if ((!e.isUndoing && !e.isRedoing) || !list) {
+			return undefined;
+		}
+		const value = model.getValue();
+		return list.findLast(s => (e.isUndoing ? s.before : s.after) === value);
+	}
+
+	forget(uri: URI): void {
+		this._snapshots.delete(uri);
+	}
+
+	dispose(): void {
+		this._onDidRemember.dispose();
+		this._snapshots.clear();
+	}
+}
+
+export class AgentReviewEntry extends Disposable implements IModifiedFileEntry {
+
+	private static _idPool = 0;
+
+	readonly entryId = `agent-review-${AgentReviewEntry._idPool++}`;
+	readonly originalURI: URI;
+	readonly modifiedURI: URI;
+	readonly lastModifyingRequestId = 'agent-review';
+
+	readonly originalModel: ITextModel;
+	readonly modifiedModel: ITextModel;
+
+	private readonly _stateObs = observableValue<ModifiedFileEntryState>(this, ModifiedFileEntryState.Modified);
+	readonly state: IObservable<ModifiedFileEntryState> = this._stateObs;
+
+	// The chat-specific parts of IModifiedFileEntry are constant for agent review:
+	// there is no streaming request, no auto-accept timer, and review mode is always on.
+	readonly isCurrentlyBeingModifiedBy = constObservable<{ responseModel: IChatResponseModel; undoStopId: string | undefined } | undefined>(undefined);
+	readonly lastModifyingResponse = constObservable<IChatResponseModel | undefined>(undefined);
+	readonly rewriteRatio = constObservable(1);
+	readonly waitsForLastEdits = constObservable(false);
+	readonly reviewMode = constObservable(true);
+	/** Read by ChatEditingCodeEditorIntegration: each hunk's Keep/Undo toolbar gets its own row below the hunk. */
+	readonly hunkToolbarRows = true;
+	/** Read by ChatEditingCodeEditorIntegration: a few changed words within lines are shown as track changes. */
+	readonly trackChanges = true;
+	readonly autoAcceptController = constObservable<{ total: number; remaining: number; cancel(): void } | undefined>(undefined);
+
+	private readonly _changeService: ChatEditingTextModelChangeService;
+	private readonly _integrations = this._register(new DisposableMap<IEditorPane, IModifiedFileEntryEditorIntegration>());
+
+	/** The save of the last Undo, while it runs, and the buffer version it writes. */
+	private _undoSave: { readonly versionId: number; readonly done: Promise<void> } | undefined;
+
+	private readonly _onDidHunkAction = this._register(new Emitter<IAgentReviewHunkEvent>());
+	readonly onDidHunkAction = this._onDidHunkAction.event;
+
+	readonly diffInfo: IObservable<IDocumentDiff2>;
+
+	private _kind: AgentReviewKind;
+	get kind(): AgentReviewKind { return this._kind; }
+
+	constructor(
+		modifiedRef: IReference<IResolvedTextEditorModel>,
+		baseline: string,
+		kind: AgentReviewKind,
+		private readonly _undoHistory: AgentReviewUndoHistory,
+		@IModelService modelService: IModelService,
+		@ILanguageService languageService: ILanguageService,
+		@IInstantiationService private readonly _instantiationService: IInstantiationService,
+		@ITextFileService private readonly _textFileService: ITextFileService,
+		@ILogService private readonly _logService: ILogService,
+		@INotificationService private readonly _notificationService: INotificationService,
+	) {
+		super();
+		this._kind = kind;
+		this.modifiedModel = this._register(modifiedRef).object.textEditorModel;
+		this.modifiedURI = this.modifiedModel.uri;
+		this.originalURI = URI.from({ scheme: AGENT_REVIEW_BASELINE_SCHEME, path: this.modifiedURI.path, query: this.entryId });
+		this.originalModel = this._register(modelService.createModel(
+			createTextBufferFactory(baseline),
+			languageService.createById(this.modifiedModel.getLanguageId()),
+			this.originalURI,
+			false
+		));
+
+		this._changeService = this._register(this._instantiationService.createInstance(
+			ChatEditingTextModelChangeService,
+			this.originalModel,
+			this.modifiedModel,
+			this._stateObs,
+			// Disk reloads are agent edits: keep them pending instead of folding them into the baseline.
+			// Typing in the editor is a user edit: folded into the baseline where it does not touch a pending change.
+			// Ctrl+Z / Ctrl+Shift+Z of an Undo puts the agent's text back (or removes it again): not typing either.
+			e => isDiskReload(e) || this._isEditorUndoOfUndo(e),
+		));
+		this._changeService.extendToSubwords = true;
+		this._changeService.preserveShortMatchingLines = true;
+
+		this._register(this._changeService.onDidAcceptOrRejectAllHunks(state => {
+			this._stateObs.set(state, undefined);
+		}));
+
+		// Hunk actions from the widgets, keybindings and commands all go through diffInfo.keep/undo.
+		this.diffInfo = this._changeService.diffInfo.map(diff => ({
+			...diff,
+			keep: (change: DetailedLineRangeMapping) => this._keepHunk(diff, change),
+			undo: (change: DetailedLineRangeMapping) => this._undoHunk(diff, change),
+		} satisfies IDocumentDiff2));
+	}
+
+	private async _keepHunk(diff: IDocumentDiff2, change: DetailedLineRangeMapping): Promise<boolean> {
+		const previousBaseline = this.originalModel.getValue();
+		const done = await diff.keep(change);
+		if (done) {
+			this._onDidHunkAction.fire({ uri: this.modifiedURI, kind: 'accepted', baseline: this.originalModel.getValue(), previousBaseline });
+		}
+		return done;
+	}
+
+	private async _undoHunk(diff: IDocumentDiff2, change: DetailedLineRangeMapping): Promise<boolean> {
+		const wasDirty = this._hasUnsavedUserEdits();
+		const before = this.modifiedModel.getValue();
+		const done = await diff.undo(change);
+		if (!done) {
+			return false;
+		}
+		this._rememberUndo(before, !wasDirty);
+		if (this._kind === 'created' && this.modifiedModel.getValueLength() === 0) {
+			// Undoing everything the agent wrote in a new file: the file should not exist.
+			this._onDidHunkAction.fire({ uri: this.modifiedURI, kind: 'rejectFile' });
+			return true;
+		}
+		this._onDidHunkAction.fire({ uri: this.modifiedURI, kind: 'rejected' });
+		if (!wasDirty) {
+			await this.saveUndo();
+		}
+		return true;
+	}
+
+	private _rememberUndo(before: string, saved: boolean): void {
+		this._undoHistory.remember(this.modifiedModel, before, saved);
+	}
+
+	/**
+	 * An editor undo that takes one of our Undos back (or a redo that repeats it) is treated like an agent write:
+	 * pending, not folded into the baseline. (The service saves it if the Undo was saved.)
+	 */
+	private _isEditorUndoOfUndo(e: IModelContentChangedEvent): boolean {
+		if (!this._undoHistory.match(this.modifiedModel, e)) {
+			return false;
+		}
+		this._stateObs.set(ModifiedFileEntryState.Modified, undefined); // e.g. after Undo of the last hunk
+		return true;
+	}
+
+	/**
+	 * Whether the buffer has unsaved edits other than an Undo that is being saved right now. (Pressing
+	 * Undo twice quickly must save both: the first one's save makes the buffer dirty until it finishes.)
+	 */
+	private _hasUnsavedUserEdits(): boolean {
+		if (!this._textFileService.isDirty(this.modifiedURI)) {
+			return false;
+		}
+		return this._undoSave?.versionId !== this.modifiedModel.getAlternativeVersionId();
+	}
+
+	/**
+	 * Write the undone text to disk so that the file matches what the reviewer sees. Skips save
+	 * participants: formatters must not rewrite the agent's other pending lines as a side effect.
+	 * Unsaved user edits are never saved for them; in that case the undo is saved with their next save.
+	 * If the write fails, the user is told: the agent would otherwise still read its own text on disk.
+	 */
+	async saveUndo(): Promise<void> {
+		const previous = this._undoSave?.done;
+		const versionId = this.modifiedModel.getAlternativeVersionId();
+		const done = (async () => {
+			await previous;
+			let error: unknown;
+			try {
+				const saved = await this._textFileService.save(this.modifiedURI, { reason: SaveReason.EXPLICIT, skipSaveParticipants: true });
+				if (saved || !this._textFileService.isDirty(this.modifiedURI)) {
+					return;
+				}
+			} catch (err) {
+				error = err;
+			}
+			this._logService.error('[agentReview] could not save after undo', error);
+			this._notificationService.notify({
+				severity: Severity.Warning,
+				message: localize('agentReview.undoNotSaved', "Undo in {0} isn't on disk yet, so an agent reading the file still sees its own text. Save the file to write it.", basename(this.modifiedURI)),
+				actions: {
+					primary: [toAction({
+						id: 'agentReview.saveUndo',
+						label: localize('agentReview.save', "Save"),
+						run: () => this._textFileService.save(this.modifiedURI, { reason: SaveReason.EXPLICIT, skipSaveParticipants: true }),
+					})],
+				},
+			});
+		})();
+		this._undoSave = { versionId, done };
+		await done;
+		if (this._undoSave?.done === done) {
+			this._undoSave = undefined;
+		}
+	}
+
+	readonly changesCount: IObservable<number> = derived(r => this._changeService.diffInfo.read(r).changes.length);
+	readonly linesAdded: IObservable<number> = derived(r => this._changeService.diffInfo.read(r).changes.reduce((n, c) => n + c.modified.length, 0));
+	readonly linesRemoved: IObservable<number> = derived(r => this._changeService.diffInfo.read(r).changes.reduce((n, c) => n + c.original.length, 0));
+
+	getDiffInfo(): Promise<IDocumentDiff> {
+		return this._changeService.getDiffInfo();
+	}
+
+	/** The engine moved the baseline (user save folded in, git op, keep from the list, external write). */
+	async setBaseline(baseline: string, kind: AgentReviewKind): Promise<void> {
+		this._kind = kind;
+		const stateChanged = this._stateObs.get() !== ModifiedFileEntryState.Modified;
+		this._stateObs.set(ModifiedFileEntryState.Modified, undefined);
+		// Models keep one EOL, so a baseline that differs only in line endings (mixed CRLF/LF files) is the same here.
+		if (!stateChanged && this.originalModel.getValue(EndOfLinePreference.LF) === baseline.replace(/\r\n/g, '\n')) {
+			return; // e.g. the echo of a Keep that this entry reported itself
+		}
+		await this._changeService.resetDocumentValues(baseline, undefined);
+	}
+
+	async accept(): Promise<void> {
+		const previousBaseline = this._kind === 'created' ? null : this.originalModel.getValue();
+		this._changeService.keep();
+		this._stateObs.set(ModifiedFileEntryState.Accepted, undefined);
+		this._onDidHunkAction.fire({ uri: this.modifiedURI, kind: 'acceptFile', previousBaseline });
+	}
+
+	async reject(): Promise<void> {
+		await this.rejectFile();
+	}
+
+	/**
+	 * Undo every pending change of the file. Modified files: the buffer goes back to the baseline (text the
+	 * user typed outside the changes stays, it is part of the baseline) and is saved if it had no other
+	 * unsaved edits. Created files: the extension deletes the file.
+	 * @returns where the undo is: `saved` to disk, only in the buffer (`unsaved`, the user's unsaved edits
+	 * keep it dirty), or `deleted` (created file, removed by the extension).
+	 */
+	async rejectFile(): Promise<'saved' | 'unsaved' | 'deleted'> {
+		if (this._kind === 'created') {
+			this._stateObs.set(ModifiedFileEntryState.Rejected, undefined);
+			this._onDidHunkAction.fire({ uri: this.modifiedURI, kind: 'rejectFile' });
+			return 'deleted';
+		}
+		const wasDirty = this._hasUnsavedUserEdits();
+		const before = this.modifiedModel.getValue();
+		this._changeService.undo();
+		this._rememberUndo(before, !wasDirty);
+		this._stateObs.set(ModifiedFileEntryState.Rejected, undefined);
+		this._onDidHunkAction.fire({ uri: this.modifiedURI, kind: 'rejected' });
+		if (wasDirty) {
+			return 'unsaved';
+		}
+		await this.saveUndo();
+		return this._textFileService.isDirty(this.modifiedURI) ? 'unsaved' : 'saved';
+	}
+
+	enableReviewModeUntilSettled(): void {
+		// review mode is always on
+	}
+
+	getEditorIntegration(pane: IEditorPane): IModifiedFileEntryEditorIntegration {
+		let value = this._integrations.get(pane);
+		if (!value) {
+			const codeEditor = getCodeEditor(pane.getControl());
+			if (!codeEditor) {
+				throw new Error('agent review needs a code editor');
+			}
+			value = this.createEditorIntegration(codeEditor);
+			this._integrations.set(pane, value);
+		}
+		return value;
+	}
+
+	createEditorIntegration(codeEditor: ICodeEditor): ChatEditingCodeEditorIntegration {
+		// renderDiffImmediately=true: there is no "streaming" phase for agent review.
+		return this._instantiationService.createInstance(ChatEditingCodeEditorIntegration, this, codeEditor, this.diffInfo, true);
+	}
+}
diff --git a/src/vs/workbench/contrib/agentReview/browser/agentReviewMerge.ts b/src/vs/workbench/contrib/agentReview/browser/agentReviewMerge.ts
new file mode 100644
index 00000000..c82f759f
--- /dev/null
+++ b/src/vs/workbench/contrib/agentReview/browser/agentReviewMerge.ts
@@ -0,0 +1,117 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Agent review: an agent wrote a file while the user has unsaved edits in it. Resolve the conflict in
+// VS Code's 3-way merge editor:
+//   base   = the text both sides started from (the extension passes it: the last text the buffer and the
+//            disk agreed on, or the accepted baseline)
+//   input1 = the agent's version (the file on disk)
+//   input2 = the user's unsaved buffer
+//   result = the file itself
+// Neither side is lost: both are snapshotted into read-only models before anything changes. The merge
+// editor saves its result file before it starts, so the file model is first reloaded from disk (the
+// user's text lives on in input2); nothing is written until the user completes the merge. The result
+// then starts as the merge editor's own auto-merge (non-conflicting changes from both sides applied,
+// conflicts left to the user).
+
+import { DisposableStore } from '../../../../base/common/lifecycle.js';
+import { waitForState } from '../../../../base/common/observable.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ILanguageService } from '../../../../editor/common/languages/language.js';
+import { IModelService } from '../../../../editor/common/services/model.js';
+import { createTextBufferFactory } from '../../../../editor/common/model/textModel.js';
+import { ITextModelService } from '../../../../editor/common/services/resolverService.js';
+import { localize } from '../../../../nls.js';
+import { IInstantiationService, ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { IEditorService } from '../../../services/editor/common/editorService.js';
+import { ITextFileService } from '../../../services/textfile/common/textfiles.js';
+import { MergeEditorInput, MergeEditorInputData } from '../../mergeEditor/browser/mergeEditorInput.js';
+
+export const AGENT_REVIEW_MERGE_SCHEME = 'agent-review-merge';
+
+export interface IAgentReviewMergeOptions {
+	/** The common ancestor of the disk and buffer versions. */
+	readonly base: string;
+	/** Do not open the editor, only prepare the merge (tests). */
+	readonly noOpen?: boolean;
+}
+
+export interface IAgentReviewMerge {
+	readonly input: MergeEditorInput;
+	/** The agent's version, as it was on disk. */
+	readonly theirs: string;
+	/** The user's unsaved buffer, as it was. */
+	readonly yours: string;
+}
+
+let mergeIds = 0;
+
+/**
+ * Open the 3-way merge editor for a file with unsaved edits that changed on disk. Returns undefined
+ * if there is nothing to merge (the file has no unsaved edits, or isn't a text file model).
+ */
+export async function openAgentReviewMerge(accessor: ServicesAccessor, uri: URI, options: IAgentReviewMergeOptions): Promise<IAgentReviewMerge | undefined> {
+	const textFileService = accessor.get(ITextFileService);
+	const modelService = accessor.get(IModelService);
+	const languageService = accessor.get(ILanguageService);
+	const editorService = accessor.get(IEditorService);
+	const instantiationService = accessor.get(IInstantiationService);
+	const textModelService = accessor.get(ITextModelService);
+
+	const fileModel = textFileService.files.get(uri);
+	if (!fileModel?.textEditorModel || !fileModel.isDirty()) {
+		return undefined;
+	}
+	const textModel = fileModel.textEditorModel;
+	const store = new DisposableStore();
+	// The merge editor resolves its inputs through the text model service.
+	store.add(textModelService.registerTextModelContentProvider(AGENT_REVIEW_MERGE_SCHEME, {
+		provideTextContent: async resource => modelService.getModel(resource),
+	}));
+	const id = ++mergeIds;
+	const snapshot = (side: string, text: string) => {
+		const resource = URI.from({ scheme: AGENT_REVIEW_MERGE_SCHEME, path: uri.path, query: `${side}-${id}` });
+		return store.add(modelService.createModel(createTextBufferFactory(text), languageService.createById(textModel.getLanguageId()), resource, false)).uri;
+	};
+
+	const yours = textModel.getValue();
+	let reverted = false;
+	try {
+		const yoursUri = snapshot('yours', yours);
+		// Reload from disk. The merge editor saves its result before it starts: it must not save the buffer.
+		await fileModel.revert();
+		reverted = true;
+		if (fileModel.isDirty()) {
+			throw new Error(`could not reload ${uri.toString()} from disk`);
+		}
+		const theirs = textModel.getValue();
+		const theirsUri = snapshot('theirs', theirs);
+		const baseUri = snapshot('base', options.base);
+
+		const input = instantiationService.createInstance(
+			MergeEditorInput,
+			baseUri,
+			new MergeEditorInputData(theirsUri, localize('agentReview.merge.theirs', "Agent"), undefined, localize('agentReview.merge.theirsDescription', "on disk")),
+			new MergeEditorInputData(yoursUri, localize('agentReview.merge.yours', "Yours"), undefined, localize('agentReview.merge.yoursDescription', "unsaved edits")),
+			uri,
+		);
+		// After the merge model lets go of them (the input disposes it right after this event, synchronously).
+		store.add(input.onWillDispose(() => queueMicrotask(() => store.dispose())));
+		const inputModel = await input.resolve();
+		await inputModel.model.reset(); // start from the auto-merge, not from the agent's version
+		await waitForState(inputModel.model.isUpToDate, upToDate => upToDate); // open with the result diffed: no flicker
+		if (!options.noOpen) {
+			await editorService.openEditor(input, { pinned: true });
+		}
+		return { input, theirs, yours };
+	} catch (err) {
+		if (reverted) {
+			// Put the user's text back (undoable) rather than losing it with the snapshot.
+			textModel.pushEditOperations(null, [{ range: textModel.getFullModelRange(), text: yours }], () => null);
+		}
+		store.dispose();
+		throw err;
+	}
+}
diff --git a/src/vs/workbench/contrib/agentReview/browser/agentReviewSaveParticipant.ts b/src/vs/workbench/contrib/agentReview/browser/agentReviewSaveParticipant.ts
new file mode 100644
index 00000000..341604e2
--- /dev/null
+++ b/src/vs/workbench/contrib/agentReview/browser/agentReviewSaveParticipant.ts
@@ -0,0 +1,82 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Agent review: attribution of edits made while a file is being saved. Save participants (format on
+// save, code actions on save, trim whitespace, other extensions' onWillSave edits) run in registration
+// order, and the extension host's participant usually runs after the core ones. So by the time the
+// agent-review extension hears about a save, formatter edits are already in the buffer and look like
+// the user's typing.
+//
+// Two participants bracket all others: the first records the model's version before any participant
+// runs; the last tells the extension `agentReview.ext.onWillWrite({ uri, userVersion, version })`
+// right before the write. Buffer edits after `userVersion` were made by the editor during the save,
+// not by the user: the engine keeps them pending inside agent hunks and folds them in elsewhere.
+
+import { raceTimeout } from '../../../../base/common/async.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { ResourceMap } from '../../../../base/common/map.js';
+import { URI } from '../../../../base/common/uri.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { IWorkbenchContribution } from '../../../common/contributions.js';
+import { ITextFileEditorModel, ITextFileService } from '../../../services/textfile/common/textfiles.js';
+
+/** Payload of `agentReview.ext.onWillWrite`. */
+export interface IAgentReviewWillWriteEvent {
+	readonly uri: URI;
+	/** Model version before save participants ran: edits up to here are the user's. */
+	readonly userVersion: number;
+	/** Model version about to be written. */
+	readonly version: number;
+}
+
+/** Same budget the extension host gets for onWillSaveTextDocument. */
+const WILL_WRITE_TIMEOUT_MS = 1750;
+
+export class AgentReviewSaveParticipants extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.agentReviewSaveParticipants';
+	static readonly FIRST = -1_000_000;
+	static readonly LAST = 1_000_000;
+
+	private readonly _userVersions = new ResourceMap<number>();
+
+	constructor(
+		@ITextFileService textFileService: ITextFileService,
+		@ICommandService private readonly _commandService: ICommandService,
+		@ILogService private readonly _logService: ILogService,
+	) {
+		super();
+		this._register(textFileService.files.addSaveParticipant({
+			ordinal: AgentReviewSaveParticipants.FIRST,
+			participate: async model => this._willParticipate(model),
+		}));
+		this._register(textFileService.files.addSaveParticipant({
+			ordinal: AgentReviewSaveParticipants.LAST,
+			participate: model => this._willWrite(model),
+		}));
+	}
+
+	private _willParticipate(model: ITextFileEditorModel): void {
+		if (model.textEditorModel) {
+			this._userVersions.set(model.resource, model.textEditorModel.getVersionId());
+		}
+	}
+
+	private async _willWrite(model: ITextFileEditorModel): Promise<void> {
+		const userVersion = this._userVersions.get(model.resource);
+		this._userVersions.delete(model.resource);
+		if (userVersion === undefined || !model.textEditorModel) {
+			return;
+		}
+		const event: IAgentReviewWillWriteEvent = { uri: model.resource, userVersion, version: model.textEditorModel.getVersionId() };
+		try {
+			// Bounded: a slow or missing extension must never block saving.
+			await raceTimeout(this._commandService.executeCommand('agentReview.ext.onWillWrite', event), WILL_WRITE_TIMEOUT_MS);
+		} catch (err) {
+			this._logService.trace('[agentReview] onWillWrite not delivered', err);
+		}
+	}
+}
diff --git a/src/vs/workbench/contrib/agentReview/browser/agentReviewService.ts b/src/vs/workbench/contrib/agentReview/browser/agentReviewService.ts
new file mode 100644
index 00000000..155f9ac4
--- /dev/null
+++ b/src/vs/workbench/contrib/agentReview/browser/agentReviewService.ts
@@ -0,0 +1,255 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// Agent review: holds one AgentReviewEntry per file with pending agent changes and exposes them to
+// the existing chat-editing review UI by registering an IChatEditReviewSession. Registering the
+// session is all it takes for the core UI to pick the entries up: the editor overlay (file i of n,
+// change j of m), per-hunk Keep/Undo widgets, deleted lines as real rows (view zones),
+// keybindings, and explorer decorations.
+
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { Disposable, DisposableMap, IDisposable } from '../../../../base/common/lifecycle.js';
+import { ResourceMap } from '../../../../base/common/map.js';
+import { IObservable, IReader, observableValue } from '../../../../base/common/observable.js';
+import { isEqual } from '../../../../base/common/resources.js';
+import { URI } from '../../../../base/common/uri.js';
+import { localize } from '../../../../nls.js';
+import { ITextModel } from '../../../../editor/common/model.js';
+import { IModelService } from '../../../../editor/common/services/model.js';
+import { ITextModelContentProvider, ITextModelService } from '../../../../editor/common/services/resolverService.js';
+import { createDecorator, IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { IUndoRedoService, UndoRedoElementType } from '../../../../platform/undoRedo/common/undoRedo.js';
+import { IChatEditReviewSession, IChatEditingService, IModifiedFileEntry } from '../../chat/common/editing/chatEditingService.js';
+import { SaveReason } from '../../../common/editor.js';
+import { ITextFileService } from '../../../services/textfile/common/textfiles.js';
+import { AGENT_REVIEW_BASELINE_SCHEME, AgentReviewEntry, AgentReviewKind, AgentReviewUndoHistory, IAgentReviewHunkEvent } from './agentReviewEntry.js';
+import { openAgentReviewMerge } from './agentReviewMerge.js';
+
+export const IAgentReviewService = createDecorator<IAgentReviewService>('agentReviewService');
+
+export interface IAgentReviewService {
+	readonly _serviceBrand: undefined;
+	readonly session: IChatEditReviewSession;
+	readonly onDidHunkAction: Event<IAgentReviewHunkEvent>;
+	/** All entries; changes whenever a file starts or stops having pending changes. */
+	readonly entries: IObservable<readonly AgentReviewEntry[]>;
+	/** Show `uri` as pending against `baseline`. Creates or updates the entry. */
+	setBaseline(uri: URI, baseline: string, kind?: AgentReviewKind): Promise<AgentReviewEntry | undefined>;
+	/** Stop reviewing `uri` (nothing pending any more). */
+	remove(uri: URI): void;
+	/** Remove every entry (the extension re-pushes everything it knows when it starts). */
+	clear(): void;
+	/**
+	 * Resolve an agent write that hit unsaved edits in the 3-way merge editor (base, agent's version on disk,
+	 * the user's buffer). False if there is nothing to merge (no unsaved edits).
+	 */
+	openMerge(uri: URI, base: string): Promise<boolean>;
+	getEntry(uri: URI): AgentReviewEntry | undefined;
+}
+
+class AgentReviewSession extends Disposable implements IChatEditReviewSession {
+
+	// `true` so that the editor overlay (ChatEditingOverlayController) shows for our entries.
+	readonly isGlobalEditingSession = true;
+	readonly chatSessionResource = URI.from({ scheme: 'agent-review', path: '/session' });
+
+	private readonly _onDidDispose = this._register(new Emitter<void>());
+	readonly onDidDispose = this._onDidDispose.event;
+
+	readonly entriesObs = observableValue<readonly AgentReviewEntry[]>(this, []);
+	readonly entries: IObservable<readonly IModifiedFileEntry[]> = this.entriesObs;
+
+	getEntry(uri: URI): IModifiedFileEntry | undefined {
+		return this.entriesObs.get().find(e => isEqual(e.modifiedURI, uri));
+	}
+
+	readEntry(uri: URI, reader: IReader): IModifiedFileEntry | undefined {
+		return this.entriesObs.read(reader).find(e => isEqual(e.modifiedURI, uri));
+	}
+
+	async accept(...uris: URI[]): Promise<void> {
+		await Promise.all(this._select(uris).map(e => e.accept()));
+	}
+
+	async reject(...uris: URI[]): Promise<void> {
+		await Promise.all(this._select(uris).map(e => e.reject()));
+	}
+
+	private _select(uris: URI[]): AgentReviewEntry[] {
+		const all = this.entriesObs.get();
+		return uris.length === 0 ? [...all] : all.filter(e => uris.some(u => isEqual(u, e.modifiedURI)));
+	}
+
+	override dispose(): void {
+		this._onDidDispose.fire();
+		super.dispose();
+	}
+}
+
+export class AgentReviewService extends Disposable implements IAgentReviewService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private readonly _session = this._register(new AgentReviewSession());
+	readonly session: IChatEditReviewSession = this._session;
+
+	private readonly _entries = new ResourceMap<{ entry: AgentReviewEntry; listener: IDisposable }>();
+	private readonly _pending = new ResourceMap<Promise<AgentReviewEntry | undefined>>();
+	/** Latest request per resource while the entry is being created (requests can arrive back to back). */
+	private readonly _latest = new ResourceMap<{ baseline: string; kind: AgentReviewKind } | null>();
+
+	get entries(): IObservable<readonly AgentReviewEntry[]> {
+		return this._session.entriesObs;
+	}
+
+	private readonly _onDidHunkAction = this._register(new Emitter<IAgentReviewHunkEvent>());
+	readonly onDidHunkAction = this._onDidHunkAction.event;
+
+	private readonly _undoHistory = new AgentReviewUndoHistory();
+	private readonly _undoHistoryListeners = this._register(new DisposableMap<string>());
+
+	constructor(
+		@IChatEditingService chatEditingService: IChatEditingService,
+		@ITextModelService private readonly _textModelService: ITextModelService,
+		@IModelService private readonly _modelService: IModelService,
+		@IInstantiationService private readonly _instantiationService: IInstantiationService,
+		@IUndoRedoService private readonly _undoRedoService: IUndoRedoService,
+		@ITextFileService private readonly _textFileService: ITextFileService,
+	) {
+		super();
+		this._register(this._undoHistory);
+		this._register(this._undoHistory.onDidRemember(model => this._watchUndoOfUndo(model)));
+		this._register(chatEditingService.registerEditReviewSession(this._session));
+
+		// Lets "open side-by-side diff" (toggleDiff) resolve the in-memory baseline model.
+		const modelService = this._modelService;
+		this._register(_textModelService.registerTextModelContentProvider(AGENT_REVIEW_BASELINE_SCHEME, new class implements ITextModelContentProvider {
+			async provideTextContent(resource: URI): Promise<ITextModel | null> {
+				return modelService.getModel(resource);
+			}
+		}));
+	}
+
+	async openMerge(uri: URI, base: string): Promise<boolean> {
+		const merge = await this._instantiationService.invokeFunction(openAgentReviewMerge, uri, { base });
+		return !!merge;
+	}
+
+	getEntry(uri: URI): AgentReviewEntry | undefined {
+		return this._entries.get(uri)?.entry;
+	}
+
+	async setBaseline(uri: URI, baseline: string, kind: AgentReviewKind = 'modified'): Promise<AgentReviewEntry | undefined> {
+		const existing = this._entries.get(uri);
+		if (existing) {
+			await existing.entry.setBaseline(baseline, kind);
+			return existing.entry;
+		}
+		this._latest.set(uri, { baseline, kind });
+		let pending = this._pending.get(uri);
+		if (!pending) {
+			pending = this._createEntry(uri).finally(() => {
+				this._pending.delete(uri);
+				this._latest.delete(uri);
+			});
+			this._pending.set(uri, pending);
+		}
+		return pending;
+	}
+
+	private async _createEntry(uri: URI): Promise<AgentReviewEntry | undefined> {
+		const ref = await this._textModelService.createModelReference(uri);
+		const latest = this._latest.get(uri);
+		if (this._store.isDisposed || !latest) {
+			// disposed, or removed while the model was resolving
+			ref.dispose();
+			return undefined;
+		}
+		const entry = this._instantiationService.createInstance(AgentReviewEntry, ref, latest.baseline, latest.kind, this._undoHistory);
+		const listener = entry.onDidHunkAction(e => {
+			this._onDidHunkAction.fire(e);
+			this._pushUndoForKeep(e);
+		});
+		this._entries.set(uri, { entry, listener });
+		this._session.entriesObs.set([...this._session.entriesObs.get(), entry], undefined);
+		return entry;
+	}
+
+	/**
+	 * Ctrl+Z after an Undo that was saved: save again, so that the disk shows the agent's text, pending, as the editor
+	 * does. With the entry gone (the Undo was the file's last change), the save is what brings the change back: the
+	 * engine sees an external write.
+	 */
+	private _watchUndoOfUndo(model: ITextModel): void {
+		const key = model.uri.toString();
+		if (this._undoHistoryListeners.has(key)) {
+			return;
+		}
+		const listener = model.onDidChangeContent(e => {
+			if (!this._undoHistory.match(model, e)?.saved) {
+				return;
+			}
+			setTimeout(() => { // not while the model is still dispatching this change
+				const entry = this.getEntry(model.uri);
+				if (entry) {
+					entry.saveUndo();
+				} else if (!model.isDisposed()) {
+					this._textFileService.save(model.uri, { reason: SaveReason.EXPLICIT, skipSaveParticipants: true });
+				}
+			}, 0);
+		});
+		const disposeListener = model.onWillDispose(() => {
+			this._undoHistory.forget(model.uri);
+			this._undoHistoryListeners.deleteAndDispose(key);
+		});
+		this._undoHistoryListeners.set(key, { dispose: () => { listener.dispose(); disposeListener.dispose(); } });
+	}
+
+	/**
+	 * Ctrl+Z after a Keep (hunk or file, in the editor) puts the change back up for review: the engine's baseline goes
+	 * back to what it was, and the change is pushed back in. Ctrl+Shift+Z keeps it again. The element lives on the
+	 * file's own undo stack, so it interleaves with typing and Undo, and works after the last Keep removed the entry.
+	 */
+	private _pushUndoForKeep(e: IAgentReviewHunkEvent): void {
+		if ((e.kind !== 'accepted' && e.kind !== 'acceptFile') || e.previousBaseline === undefined) {
+			return;
+		}
+		const { uri, previousBaseline } = e;
+		const redo: IAgentReviewHunkEvent = e.kind === 'accepted' ? { uri, kind: 'restore', baseline: e.baseline } : { uri, kind: 'acceptFile' };
+		this._undoRedoService.pushElement({
+			type: UndoRedoElementType.Resource,
+			resource: uri,
+			label: localize('agentReview.keepUndoLabel', "Keep Agent Change"),
+			code: 'agentReview.keep',
+			undo: () => this._onDidHunkAction.fire({ uri, kind: 'restore', baseline: previousBaseline }),
+			redo: () => this._onDidHunkAction.fire(redo),
+		});
+	}
+
+	remove(uri: URI): void {
+		if (this._pending.has(uri)) {
+			this._latest.set(uri, null);
+		}
+		const item = this._entries.get(uri);
+		if (!item) {
+			return;
+		}
+		this._entries.delete(uri);
+		this._session.entriesObs.set(this._session.entriesObs.get().filter(e => e !== item.entry), undefined);
+		item.listener.dispose();
+		item.entry.dispose();
+	}
+
+	clear(): void {
+		for (const uri of [...this._entries.keys(), ...this._pending.keys()]) {
+			this.remove(uri);
+		}
+	}
+
+	override dispose(): void {
+		this.clear();
+		super.dispose();
+	}
+}
diff --git a/src/vs/workbench/contrib/agentReview/browser/media/agentReview.css b/src/vs/workbench/contrib/agentReview/browser/media/agentReview.css
