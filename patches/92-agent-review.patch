+	white-space: nowrap;
+	color: var(--vscode-descriptionForeground);
+}
+
+.chat-editing-editor-overlay.agent-review .agent-review-overlay-file-name {
+	overflow: hidden;
+	text-overflow: ellipsis;
+	color: var(--vscode-foreground);
+	font-weight: 600;
+}
+
+.chat-editing-editor-overlay.agent-review .chat-editor-overlay-widget .action-item:not(.label-item) > .action-label:not(.codicon):not(.separator) {
+	padding: 4px 12px;
+	font-size: 12px;
+}
+
+/* Track changes: the edited lines get a lighter tint than the inserted words in them. */
+.monaco-editor .char-insert.agent-review-track-changes-line {
+	background-color: color-mix(in srgb, var(--vscode-diffEditor-insertedTextBackground) 40%, transparent);
+}
+
+/*
+ * High contrast themes have no diff fills: their diff colors are borders, which the diff editor draws dashed around
+ * every line and word. For agent review that read as faint outlines, and the change's Keep/Undo (no button
+ * backgrounds in high contrast) as plain text. Here a change gets a solid bar at its left and a light tint of the
+ * theme's own inserted/removed border color, and Keep/Undo are bordered buttons like the rest of the workbench's.
+ */
+.monaco-editor.hc-black .char-insert.agent-review-inserted-line,
