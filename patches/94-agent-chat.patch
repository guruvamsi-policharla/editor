+	/**
+	 * Cancel an invocation that hasn't completed yet: an extension's external tool card (a command that was
+	 * running or waiting for permission) when the user stops the request. Core drops the extension's later
+	 * updates after a cancel, so without this the card would keep its spinner.
+	 * @returns true if the cancellation was applied, false if it was already complete or cancelled
+	 */
+	public cancelIfIncomplete(reason: ToolConfirmKind.Denied | ToolConfirmKind.Skipped, reasonMessage?: string | IMarkdownString): boolean {
+		const type = this._state.get().type;
+		if (type === IChatToolInvocation.StateKind.Completed || type === IChatToolInvocation.StateKind.Cancelled) {
+			return false;
+		}
+		this._state.set({
+			type: IChatToolInvocation.StateKind.Cancelled,
+			reason,
