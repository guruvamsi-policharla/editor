+		assert.strictEqual(chatSetUpForSessionsList({ completed: true }, false), true);
+		assert.strictEqual(chatSetUpForSessionsList({}, true), true);
+	});
+});
+
+suite('AgentChat: a model picked in an extension\'s chat is reported at once', () => {
