+	/**
+	 * The reference text still present after an insertion that overlapped its decoration.
+	 * The match closest to where the reference was wins.
+	 */
+	private findUntouchedReferenceRange(model: ITextModel, text: string, previousOffset: number): Range | undefined {
+		if (!text) {
+			return undefined;
+		}
+		const value = model.getValue();
+		let match = value.indexOf(text);
+		let closest = match;
+		while (match !== -1) {
+			if (Math.abs(match - previousOffset) < Math.abs(closest - previousOffset)) {
+				closest = match;
+			}
+			match = value.indexOf(text, match + text.length);
+		}
+		if (closest === -1) {
+			return undefined;
+		}
+		const range = Range.fromPositions(model.getPositionAt(closest), model.getPositionAt(closest + text.length));
+		return model.getValueInRange(range) === text ? range : undefined;
+	}
