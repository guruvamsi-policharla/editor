+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { DefaultLinesDiffComputer } from '../../../common/diff/defaultLinesDiffComputer/defaultLinesDiffComputer.js';
+import { ILinesDiffComputerOptions } from '../../../common/diff/linesDiffComputer.js';
+import { DetailedLineRangeMapping } from '../../../common/diff/rangeMapping.js';
+
+suite('alignSimilarLines', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	// LaTeX prose, one paragraph per line, as an agent edits it.
+	const A = String.raw`Note that the setup ceremony verifies an epoch identifier without any interaction. To this end, the decryptor samples a succinct proof of correctness without any interaction. To this end, our construction aggregates the vector $\mathbf{x}$ of ciphertexts without any interaction~\cite{desmedt1989threshold}. Unlike prior work, each party broadcasts a partial decryption share which is the dominant cost in practice.`;
+	const B = String.raw`Concretely, the aggregator aggregates the batch commitment which is the dominant cost in practice. Note that the batch outputs the vector $\mathbf{x}$ of ciphertexts even if $t-1$ parties are corrupt. Note that our construction publishes the batch commitment as described in \Cref{sec:construction}.`;
+	const C = String.raw`The setup ceremony reconstructs a threshold signature on the digest without any interaction. In particular, the committee publishes an epoch identifier after the epoch closes, and each server sends a single group element regardless of the batch size~\cite{boneh2001short}.`;
+	const N = String.raw`We stress that the decryption shares are \emph{constant size}: each server sends a single group element per epoch, regardless of how many ciphertexts are in the batch.`;
+	const Z = String.raw`Our implementation is written in Rust on top of \texttt{arkworks} and runs on a single core; all numbers are the median of 50 runs.`;
+	const rename = (s: string) => s.replaceAll(String.raw`\mathbf{x}`, String.raw`\mathbf{y}`).replaceAll('without any interaction', 'non-interactively');
+	const head = [String.raw`\section{Introduction}\label{sec:intro}`, ''];
+	const tail = ['', String.raw`\subsection{Correctness}\label{sec:intro-3}`, ''];
+
+	const options: ILinesDiffComputerOptions = { ignoreTrimWhitespace: false, maxComputationTimeMs: 0, computeMoves: false, extendToSubwords: true, preserveShortMatchingLines: true };
+	function diff(original: string[], modified: string[], alignSimilarLines = true) {
+		const result = new DefaultLinesDiffComputer().computeDiff(original, modified, { ...options, alignSimilarLines });
+		assertConsistent(result.changes, original, modified);
+		return result.changes.map(c => `${c.original} -> ${c.modified}`);
+	}
+
+	/** Applying every inner change to the original gives the modified text, and an unchanged line separates the changes. */
+	function assertConsistent(changes: readonly DetailedLineRangeMapping[], original: string[], modified: string[]) {
+		const offsets = (lines: string[]) => {
+			const result = [0];
+			for (const l of lines) {
+				result.push(result[result.length - 1] + l.length + 1);
+			}
+			return result;
+		};
+		const o = offsets(original);
+		const m = offsets(modified);
+		let text = original.join('\n');
+		const edits = changes.flatMap(c => c.innerChanges ?? []).reverse();
+		const modifiedText = modified.join('\n');
+		for (const e of edits) {
+			const start = o[e.originalRange.startLineNumber - 1] + e.originalRange.startColumn - 1;
+			const end = o[e.originalRange.endLineNumber - 1] + e.originalRange.endColumn - 1;
+			const newText = modifiedText.slice(m[e.modifiedRange.startLineNumber - 1] + e.modifiedRange.startColumn - 1, m[e.modifiedRange.endLineNumber - 1] + e.modifiedRange.endColumn - 1);
+			text = text.slice(0, start) + newText + text.slice(end);
+		}
+		assert.strictEqual(text, modifiedText);
+		for (let i = 1; i < changes.length; i++) {
+			assert.ok(changes[i - 1].original.endLineNumberExclusive < changes[i].original.startLineNumber, `${changes[i - 1]} / ${changes[i]}`);
+			assert.ok(changes[i - 1].modified.endLineNumberExclusive < changes[i].modified.startLineNumber, `${changes[i - 1]} / ${changes[i]}`);
+		}
+	}
+
+	test('a paragraph edited next to a deleted paragraph: one-line edit, and the deletion on its own', () => {
+		const original = [...head, A, '', B, ...tail];
+		const modified = [...head, rename(A), ...tail];
+		// Without the option, both paragraphs are one change: the edited one deleted and inserted again.
+		assert.deepStrictEqual(diff(original, modified, false), ['[3,6) -> [3,4)']);
+		assert.deepStrictEqual(diff(original, modified), ['[3,4) -> [3,4)', '[5,7) -> [5,5)']);
+	});
+
+	test('a paragraph deleted before an edited one', () => {
+		const original = [...head, B, '', A, ...tail];
+		const modified = [...head, rename(A), ...tail];
+		assert.deepStrictEqual(diff(original, modified), ['[2,4) -> [2,2)', '[5,6) -> [3,4)']);
+	});
+
+	test('a paragraph inserted after an edited one', () => {
+		const original = [...head, A, '', C, ...tail];
+		const modified = [...head, rename(A), '', N, '', C, ...tail];
+		assert.deepStrictEqual(diff(original, modified), ['[3,4) -> [3,4)', '[5,5) -> [5,7)']);
+	});
+
+	test('a paragraph inserted before an edited one', () => {
+		const original = [...head, A, '', C, ...tail];
+		const modified = [...head, A, '', N, '', rename(C), ...tail];
+		assert.deepStrictEqual(diff(original, modified), ['[4,4) -> [4,6)', '[5,6) -> [7,8)']);
+	});
+
+	test('blank lines that could pair either way: each edited paragraph still pairs with its old version', () => {
+		// Two edited paragraphs, a new one glued to the second, and an extra blank line (polish-1, intro.tex).
+		const original = [...head, A, '', C, ...tail];
+		const modified = [...head, rename(A), '', rename(C), N, '', ...tail];
+		assert.deepStrictEqual(diff(original, modified), ['[3,4) -> [3,4)', '[5,6) -> [5,8)']);
+	});
+
+	test('one sentence per line: an edited sentence and a deleted one after it stay one change', () => {
+		// No unchanged line can separate them.
+		const sentences = A.split('. ').map(s => s + '.');
+		const original = [...head, ...sentences, ...tail];
+		const modified = [...head, rename(sentences[0]), ...sentences.slice(2), ...tail];
+		assert.deepStrictEqual(diff(original, modified), ['[3,5) -> [3,4)']);
+	});
+
+	test('unrelated paragraphs are not paired', () => {
+		// The same field, many shared words: still not similar, so this stays one change of whole paragraphs.
+		const original = [...head, A, '', C, ...tail];
+		const modified = [...head, B, ...tail];
+		assert.deepStrictEqual(diff(original, modified), ['[3,6) -> [3,4)']);
+	});
+
+	test('random paragraph edits, insertions and deletions: inner changes always rebuild the new text', () => {
+		const paragraphs = [A, B, C, N, Z, rename(A), rename(B), String.raw`\begin{equation}`, String.raw`\end{equation}`, '%', ''];
