+export function showAsTrackChanges(change: DetailedLineRangeMapping, original: ITextModel, modified: ITextModel): boolean {
+	if (change.original.isEmpty || change.modified.isEmpty || change.original.length !== change.modified.length || !change.innerChanges?.length) {
+		return false;
+	}
+	let changed = 0;
+	for (const i of change.innerChanges) {
