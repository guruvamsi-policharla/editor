+	private _lastLineWithDeletedText(change: DetailedLineRangeMapping, original: ITextModel, modified: ITextModel, trackChanges: boolean): string {
+		const line = change.modified.endLineNumberExclusive - 1;
+		let text = modified.getLineContent(line);
+		if (trackChanges) {
+			const deleted = (change.innerChanges ?? []).filter(i => i.modifiedRange.startLineNumber === line && !i.originalRange.isEmpty() && !deletedWholeLines(i, original));
+			for (const i of deleted.reverse()) {
+				const at = i.modifiedRange.startColumn - 1;
+				text = text.slice(0, at) + original.getValueInRange(i.originalRange) + text.slice(at);
+			}
+		}
+		return text;
+	}
