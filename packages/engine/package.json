{
  "name": "@editor/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Editor-independent review engine: accepted baseline, hunks, accept/reject, git-op detection.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ignore": "^7.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
