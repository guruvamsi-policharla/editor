{
  "name": "agent-chat",
  "displayName": "Agent Chat",
  "description": "Chat with tact in VS Code's native chat, over ACP. tact edits files itself; edits are reviewed inline with Keep/Undo.",
  "version": "0.0.1",
  "publisher": "editor",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantPrivate",
    "chatParticipantAdditions",
    "defaultChatParticipant",
    "chatProvider"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "agent-chat.default",
        "name": "agent",
        "fullName": "Agent",
        "description": "Chat with tact",
        "isDefault": true,
        "modes": [
          "ask",
          "agent",
          "edit"
        ],
        "locations": [
          "panel"
        ],
        "when": "config.agentChat.tact.enabled"
      }
    ],
    "chatSessions": [
      {
        "type": "agent-tact",
        "name": "tact",
        "displayName": "tact",
        "icon": "$(rocket)",
        "welcomeTitle": "tact",
        "welcomeMessage": "Your own tact (Nanocodex). It runs commands and edits files without asking (tact has no approval mode); every edit in the workspace shows up inline for review with Keep/Undo.",
        "inputPlaceholder": "Ask tact. @ to reference",
        "order": 1,
        "canDelegate": true,
        "capabilities": {
          "supportsFileAttachments": true
        },
        "requiresCustomModels": true,
        "commands": [
          {
            "name": "compact",
            "description": "Summarize the conversation to free up context"
          }
        ],
        "when": "config.agentChat.tact.enabled"
      }
    ],
    "configurationDefaults": {
      "chat.editor.localAgent.enabled": false,
      "chat.saveBeforeSend": false,
      "chat.implicitContext.enabled": {
        "panel": "never"
      },
      "chat.fontSize": 14
    },
    "commands": [
      {
        "command": "agentChat.newChat",
        "title": "New Agent Chat",
        "category": "Agent Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentChat.newChatInEditor",
        "title": "New Agent Chat in Editor",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.newTact",
        "title": "New tact Chat",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.insertReference",
        "title": "Insert Selection Reference into Chat",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.login",
        "title": "Sign In to tact",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.restart",
        "title": "Restart tact",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.showLog",
        "title": "Show Log",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.searchChats",
        "title": "Search Chats…",
        "category": "Agent Chat",
        "icon": "$(search)"
      },
      {
        "command": "agentChat.runNow",
        "title": "Run Now (Don't Wait for the Other Chat)",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.removeChat",
        "title": "Remove from Chat History",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.login.tact",
        "title": "Sign In to tact",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.restart.tact",
        "title": "Restart tact",
        "category": "Agent Chat"
      }
    ],
    "configuration": {
      "title": "Agent Chat",
      "properties": {
        "agentChat.tact.enabled": {
          "type": "boolean",
          "default": false,
          "order": 0,
          "markdownDescription": "Experimental: the built-in chat panel, which runs your own [tact](https://github.com/clabby/tact) over ACP, and Cmd/Ctrl+L to reference a selection in it. Off: no chat panel, chat commands or Cmd/Ctrl+L binding, and nothing is started. Inline review (Keep/Undo) works either way, e.g. with the Codex or Claude Code extensions. Changing it asks to reload the window."
        },
        "agentChat.harnesses": {
          "type": "object",
          "default": {},
          "markdownDescription": "Overrides for the agent harness, keyed by `tact`: `adapterPath` (an ACP adapter command instead of the one that ships with the editor), `harnessPath` (the `tact` CLI instead of the one on PATH), `env` (extra adapter environment, e.g. `{\"TACT_HOME\": \"…\"}`), `defaults` (config option values set on new sessions, e.g. `{\"speed\": \"fast\"}`; a value the model doesn't offer is skipped). Entries for harnesses the editor no longer runs (`claude`, `codex`) are ignored.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "adapterPath": {
                "type": "string"
              },
              "harnessPath": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "defaults": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "agentChat.turns.waitForOtherChats": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "One agent edits at a time: a message in one chat waits (\"Waiting for … to finish\") while another chat's turn is running, then starts by itself. **Run now** in the waiting chat starts it anyway. Chats in a mode that doesn't edit (plan, read-only) never wait."
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "agent-chat",
        "displayName": "Agent harness models"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentChat.insertReference",
          "when": "config.agentChat.tact.enabled && editorTextFocus"
        },
        {
          "command": "agentChat.runNow",
          "when": "false"
        },
        {
          "command": "agentChat.removeChat",
          "when": "false"
        },
        {
          "command": "agentChat.newChat",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.newChatInEditor",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.newTact",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.login",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.restart",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.showLog",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.searchChats",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.login.tact",
          "when": "config.agentChat.tact.enabled"
        },
        {
          "command": "agentChat.restart.tact",
          "when": "config.agentChat.tact.enabled"
        }
      ],
      "view/title": [
        {
          "command": "agentChat.searchChats",
          "when": "config.agentChat.tact.enabled && view == workbench.panel.chat.view.copilot",
          "group": "navigation@-1"
        }
      ],
      "editor/title": [
        {
          "command": "agentChat.searchChats",
          "when": "config.agentChat.tact.enabled && activeEditor == workbench.editor.chatSession",
          "group": "navigation@1"
        }
      ],
      "chat/chatSessions": [
        {
          "command": "agentChat.removeChat",
          "when": "config.agentChat.tact.enabled && chatSessionType =~ /^agent-/",
          "group": "z_remove"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@editor/acp-client": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/vscode": "1.134.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
