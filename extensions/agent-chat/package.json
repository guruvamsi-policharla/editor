{
  "name": "agent-chat",
  "displayName": "Agent Chat",
  "description": "Chat with your agent harness (Claude Code, Codex) in VS Code's native chat, over ACP. The harness edits files itself; edits are reviewed inline with Keep/Undo.",
  "version": "0.0.1",
  "publisher": "editor",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider",
    "chatParticipantPrivate",
    "chatParticipantAdditions",
    "defaultChatParticipant",
    "chatProvider"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "agent-chat.default",
        "name": "agent",
        "fullName": "Agent",
        "description": "Chat with Claude Code or Codex",
        "isDefault": true,
        "modes": [
          "ask",
          "agent",
          "edit"
        ],
        "locations": [
          "panel"
        ]
      }
    ],
    "chatSessions": [
      {
        "type": "agent-claude",
        "name": "claude",
        "displayName": "Claude Code",
        "icon": "$(sparkle)",
        "welcomeTitle": "Claude Code",
        "welcomeMessage": "Your own Claude Code. It edits files itself; every edit shows up inline for review with Keep/Undo. Commands ask first.",
        "inputPlaceholder": "Ask Claude Code. @ to reference, / for commands",
        "order": 1,
        "canDelegate": true,
        "capabilities": {
          "supportsFileAttachments": true
        },
        "requiresCustomModels": true,
        "commands": [
          {
            "name": "compact",
            "description": "Summarize the conversation to free up context"
          },
          {
            "name": "context",
            "description": "Show what fills the context window"
          },
          {
            "name": "init",
            "description": "Write a CLAUDE.md for this project"
          },
          {
            "name": "security-review",
            "description": "Review the pending changes for security issues"
          },
          {
            "name": "usage",
            "description": "Show plan usage limits"
          }
        ]
      },
      {
        "type": "agent-codex",
        "name": "codex",
        "displayName": "Codex",
        "icon": "$(terminal)",
        "welcomeTitle": "Codex",
        "welcomeMessage": "Your own Codex, in Workspace access. Its edits show up inline for review with Keep/Undo.",
        "inputPlaceholder": "Ask Codex. @ to reference, / for commands",
        "order": 2,
        "canDelegate": true,
        "capabilities": {
          "supportsFileAttachments": true
        },
        "requiresCustomModels": true,
        "commands": [
          {
            "name": "init",
            "description": "Write an AGENTS.md for this project"
          },
          {
            "name": "compact",
            "description": "Summarize the conversation to free up context"
          },
          {
            "name": "review",
            "description": "Review the current changes"
          }
        ]
      }
    ],
    "configurationDefaults": {
      "chat.editor.localAgent.enabled": false
    },
    "commands": [
      {
        "command": "agentChat.newChat",
        "title": "New Agent Chat",
        "category": "Agent Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentChat.newChatInEditor",
        "title": "New Agent Chat in Editor",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.newClaude",
        "title": "New Claude Code Chat",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.newCodex",
        "title": "New Codex Chat",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.insertReference",
        "title": "Insert Selection Reference into Chat",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.login",
        "title": "Sign In to an Agent\u2026",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.restart",
        "title": "Restart Agent\u2026",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.showLog",
        "title": "Show Log",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.login.claude",
        "title": "Sign In to Claude Code",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.restart.claude",
        "title": "Restart Claude Code",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.login.codex",
        "title": "Sign In to Codex",
        "category": "Agent Chat"
      },
      {
        "command": "agentChat.restart.codex",
        "title": "Restart Codex",
        "category": "Agent Chat"
      }
    ],
    "configuration": {
      "title": "Agent Chat",
      "properties": {
        "agentChat.harnesses": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-harness overrides, keyed by `claude` / `codex`: `adapterPath` (an installed ACP adapter command instead of the pinned download), `harnessPath` (the `claude`/`codex` CLI instead of the one on PATH), `env` (extra adapter environment), `defaults` (config option values set on new sessions, e.g. `{\"mode\": \"default\"}`).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "adapterPath": {
                "type": "string"
              },
              "harnessPath": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "defaults": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "agent-chat",
        "displayName": "Agent harness models"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentChat.insertReference",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@editor/acp-client": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/vscode": "1.134.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
