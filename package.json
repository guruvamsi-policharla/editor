{
  "name": "editor",
  "private": true,
  "description": "Agent-agnostic inline review: VSCodium-based fork, review engine, built-in extension",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "10.8.0",
    "typescript-eslint": "8.66.0"
  }
}
